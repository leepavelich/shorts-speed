{
  "manifest_version": 3,
  "name": "Shorts Speed",
  "version": "1.0.1",
  "description": "Adds playback speed controls to YouTube Shorts.",
  "permissions": ["storage"],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
